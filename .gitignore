# Scratch layouts written by test runs (?decor=<name>), in any workspace. Named
# layouts (layouts/decor.<slug>.json) are real design variants and stay versioned.
examples/*/layouts/decor.e2e*.json
examples/*/layouts/decor.test*.json
examples/*/layouts/decor.shot*.json
examples/*/layouts/decor.snap.json
examples/*/layouts/decor.furn.json
examples/*/layouts/decor.edit.json
examples/*/layouts/decor.objects.json
examples/*/layouts/decor.devices.json

# Test output (screenshots from pnpm test:e2e)
test-results

# Agent worktrees
.claude/worktrees/

# Everyone's spaces: plans, layouts and artwork (FLOORPLAN_DATA)
storage

# The browser tests' throwaway data folder
tests/e2e/.data

# Compose secrets (CLOUDFLARE_TUNNEL_TOKEN)
.env

# Cloudflare Tunnel credentials (copy of ~/.cloudflared/<tunnel-id>.json)
.cloudflared
